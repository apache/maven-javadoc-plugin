<project>
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.maven.its.javadoc</groupId>
  <artifactId>test-scoped-module-links</artifactId>
  <version>0.1</version>
  <packaging>pom</packaging>

  <description>
    A module that depends on another reactor module only in test scope, where that module has no Java sources:
    no offline link to it is detected, so no Javadoc run is invoked for it and no link error is logged.
  </description>
  <!-- detectOfflineLinks only looks at modules with a URL -->
  <url>https://example.org/</url>

  <modules>
    <module>fixtures</module>
    <module>lib</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>@project.version@</version>
        <configuration>
          <detectOfflineLinks>true</detectOfflineLinks>
        </configuration>
        <executions>
          <execution>
            <id>attach</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
